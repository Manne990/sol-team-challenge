{
  "name": "northstar-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Northstar CRM",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "NODE_ENV=production node dist/server/server/index.js",
    "build": "vite build && tsc -p tsconfig.server.json",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run check:static && npm run check:test-policy && npm run test:component && npm run test:unit && npm run test:integration && npm run test:db && npm run build && npm run test:browser",
    "check:test-policy": "node scripts/check-test-policy.mjs",
    "check:static": "node scripts/static-checks.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write README.md docs/architecture.md eslint.config.js package.json src/server src/shared tsconfig.json tsconfig.server.json vite.config.ts",
    "format:check": "prettier --check README.md docs/architecture.md eslint.config.js package.json src/server src/shared tsconfig.json tsconfig.server.json vite.config.ts",
    "test": "vitest",
    "test:component": "vitest run",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:db": "node --test test/database.test.mjs",
    "test:browser": "playwright install chromium && node scripts/run-browser-tests.mjs",
    "db:reset": "node scripts/db.mjs reset",
    "db:seed": "node scripts/db.mjs seed"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "latest",
    "prettier": "^3.9.6",
    "tsx": "^4.23.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
