{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "sourceMap": true,
    "noEmit": false
  },
  "include": [
    "src/auth/**/*.ts",
    "src/companies/**/*.ts",
    "src/deals/**/*.ts",
    "src/imports/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/tasks/**/*.ts"
  ]
}
